# Conexão PostgreSQL
DATABASE_URL=postgres://masie:masie@localhost:5432/masie
# Banco usado pelos testes de integração (será limpo a cada execução)
TEST_DATABASE_URL=postgres://masie:masie@localhost:5432/masie_test
# Chave AES-256 (32 bytes em base64) para dados bancários/PIX. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DADOS_SENSIVEIS_CHAVE=
# Pasta para anexos (driver local). Em produção use armazenamento privado.
ARMAZENAMENTO_DIR=./storage
# Senha inicial do administrador criada pelo seed (troca obrigatória no 1º login)
SEED_ADMIN_EMAIL=admin@masie.com.br
SEED_ADMIN_SENHA=
